---
import '../styles/global.css';
const { title } = Astro.props;
const siteUrl = 'https://thalux.ai';
const pageTitle = title ? `Thalux AI — ${title}` : 'Thalux AI';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Thalux AI builds the digital infrastructure for trade shops — websites, Google Business Profile, Facebook marketing, and AI voice receptionist. Month-to-month, no contracts." />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content="Websites that work. Calls that get answered. Customers that find you. Thalux AI — your shop's digital infrastructure." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl + Astro.url.pathname} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content="https://thalux.ai/og-default.svg" />
    <meta name="twitter:image" content="https://thalux.ai/og-default.svg" />
    <link rel="canonical" href={siteUrl + Astro.url.pathname.replace(/\/$/, '')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Thalux AI",
      "description": "Digital infrastructure for trade shops — websites, GBP, Facebook marketing, and AI voice receptionist.",
      "url": "https://thalux.ai",
      "email": "admin@thalux.ai",
      "telephone": "+17175370566",
      "priceRange": "$195-$499"
    })} />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9GJEFJEFK0"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-9GJEFJEFK0');
    </script>
  </head>
  <body class="bg-[#F5F4F0] text-[#2D2D2D] font-['Inter'] antialiased">
    <!-- Announcement Bar -->
    <div class="bg-[#E5B73C] text-white text-center text-sm font-medium py-3 px-6 tracking-wide">
      ✦ Your shop's digital infrastructure ✦
    </div>

    <!-- Navigation -->
    <nav class="bg-white border-b border-[#DED8D0]">
      <div class="max-w-6xl mx-auto px-6 flex items-center justify-between h-16">
        <a href="/" class="font-['Manrope'] text-lg font-bold text-[#2D2D2D] tracking-tight">
          Thalux<span class="text-[#E5B73C]"> AI</span>
        </a>
        <div class="flex items-center gap-6 text-sm font-medium">
          <a href="/" class="text-[#2D2D2D] hover:text-[#E5B73C] transition-colors">Home</a>
          <a href="/services" class="text-[#2D2D2D] hover:text-[#E5B73C] transition-colors">Services</a>
          <a href="/about" class="text-[#2D2D2D] hover:text-[#E5B73C] transition-colors">About</a>
          <a href="/portal" class="text-[#2D2D2D] hover:text-[#E5B73C] transition-colors">Client Portal</a>
          <a href="/contact" class="bg-[#E5B73C] text-white px-5 py-2 rounded-md font-['Manrope'] font-bold text-sm hover:bg-[#CDA333] transition-colors">Contact</a>
        </div>
      </div>
    </nav>

    <slot />

    <!-- Footer -->
    <footer class="bg-[#2D2D2D] text-white py-16">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid md:grid-cols-3 gap-10">
          <div>
            <div class="font-['Manrope'] text-lg font-bold mb-3">
              Thalux<span class="text-[#E5B73C]"> AI</span>
            </div>
            <p class="text-sm text-gray-400 leading-relaxed">
              Digital infrastructure for trade shops. Month-to-month, no contracts.
            </p>
          </div>
          <div>
            <h4 class="font-['Manrope'] font-bold text-sm uppercase tracking-wider text-gray-400 mb-4">Services</h4>
            <ul class="space-y-2 text-sm text-gray-300">
              <li><a href="/services" class="hover:text-[#E5B73C] transition-colors">Website Management</a></li>
              <li><a href="/services" class="hover:text-[#E5B73C] transition-colors">GBP Optimization</a></li>
              <li><a href="/services" class="hover:text-[#E5B73C] transition-colors">Facebook Marketing</a></li>
              <li><a href="/services" class="hover:text-[#E5B73C] transition-colors">Voice Receptionist</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-['Manrope'] font-bold text-sm uppercase tracking-wider text-gray-400 mb-4">Contact</h4>
            <ul class="space-y-2 text-sm text-gray-300">
              <li><a href="tel:+17175370566" class="hover:text-[#E5B73C] transition-colors">(717) 537-0566</a></li>
              <li><a href="mailto:admin@thalux.ai" class="hover:text-[#E5B73C] transition-colors">admin@thalux.ai</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-gray-700 mt-10 pt-6 text-sm text-gray-500 text-center">
          &copy; {new Date().getFullYear()} Thalux AI. No robots were harmed in the making of this site.
        </div>
      </div>
    </footer>
  </body>
</html>