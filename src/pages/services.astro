---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Services & Pricing">
  <!-- Header -->
  <section class="max-w-6xl mx-auto px-6 pt-20 pb-12">
    <h1 class="font-['Manrope'] text-4xl md:text-5xl font-extrabold text-[#2D2D2D] mb-4 tracking-tight">
      Services & <span class="text-[#E5B73C]">Pricing</span>
    </h1>
    <p class="text-lg text-[#333333] mb-2 max-w-2xl leading-relaxed">
      Everything a trade shop needs to get found online. Month-to-month, no contracts.
    </p>
    <p class="text-sm text-[#666]">
      Free setup on all plans. <a href="/contact" class="text-[#E5B73C] underline">Schedule a 15-minute call →</a>
    </p>
  </section>

  <!-- Package Tiers -->
  <section class="bg-white py-16 border-t border-b border-[#DED8D0]">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="font-['Manrope'] text-3xl font-bold text-[#2D2D2D] text-center mb-10">Website + Online Presence Packages</h2>
      <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <!-- Bronze -->
        <div class="bg-white border border-[#DED8D0] rounded-xl p-8 hover:border-[#E5B73C] transition-colors">
          <div class="font-['Manrope'] font-bold text-sm text-[#E5B73C] uppercase tracking-wide mb-1">Bronze</div>
          <div class="font-['Manrope'] font-extrabold text-4xl text-[#2D2D2D] mb-1">$299 <span class="text-base font-medium text-[#666]">/mo</span></div>
          <div class="text-sm text-[#666] mb-2">Free setup</div>
          <ul class="space-y-3 mb-8 text-sm pt-4 border-t border-[#DED8D0]">
            <li class="flex items-center gap-2 text-[#333]"><span class="text-[#E5B73C] font-bold">✓</span> Website management</li>
            <li class="flex items-center gap-2 text-[#333]"><span class="text-[#E5B73C] font-bold">✓</span> GBP optimization</li>
            <li class="flex items-center gap-2 text-[#333]"><span class="text-[#E5B73C] font-bold">✓</span> Facebook marketing</li>
          </ul>
        </div>
        <!-- Silver -->
        <div class="bg-white border-2 border-[#E5B73C] rounded-xl p-8 shadow-sm scale-[1.02]">
          <div class="font-['Manrope'] font-bold text-sm text-[#E5B73C] uppercase tracking-wide mb-1">Silver</div>
          <div class="font-['Manrope'] font-extrabold text-4xl text-[#2D2D2D] mb-1">$399 <span class="text-base font-medium text-[#666]">/mo</span></div>
          <div class="text-sm text-[#666] mb-2">Most popular</div>
          <ul class="space-y-3 mb-8 text-sm pt-4 border-t border-[#DED8D0]">
            <li class="flex items-center gap-2 text-[#333]"><span class="text-[#E5B73C] font-bold">✓</span> 3-page website</li>
            <li class="flex items-center gap-2 text-[#333]"><span class="text-[#E5B73C] font-bold">✓</span> GBP optimization</li>
            <li class="flex items-center gap-2 text-[#333]"><span class="text-[#E5B73C] font-bold">✓</span> Facebook marketing</li>
          </ul>
        </div>
        <!-- Gold -->
        <div class="bg-white border border-[#DED8D0] rounded-xl p-8 hover:border-[#E5B73C] transition-colors">
          <div class="font-['Manrope'] font-bold text-sm text-[#E5B73C] uppercase tracking-wide mb-1">Gold</div>
          <div class="font-['Manrope'] font-extrabold text-4xl text-[#2D2D2D] mb-1">$499 <span class="text-base font-medium text-[#666]">/mo</span></div>
          <div class="text-sm text-[#666] mb-2">Full package</div>
          <ul class="space-y-3 mb-8 text-sm pt-4 border-t border-[#DED8D0]">
            <li class="flex items-center gap-2 text-[#333]"><span class="text-[#E5B73C] font-bold">✓</span> 5-page website</li>
            <li class="flex items-center gap-2 text-[#333]"><span class="text-[#E5B73C] font-bold">✓</span> GBP optimization</li>
            <li class="flex items-center gap-2 text-[#333]"><span class="text-[#E5B73C] font-bold">✓</span> Facebook marketing</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- AI Receptionist Add-on -->
  <section class="py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-3xl mx-auto bg-white border-2 border-[#E5B73C] rounded-xl p-10 shadow-sm text-center">
        <span class="inline-block bg-[rgba(229,183,60,0.12)] text-[#E5B73C] font-['Manrope'] font-bold text-xs px-4 py-2 rounded-full mb-4 uppercase tracking-wider">Add-on Service</span>
        <h2 class="font-['Manrope'] text-3xl font-bold text-[#2D2D2D] mb-2">AI Receptionist</h2>
        <div class="font-['Manrope'] font-extrabold text-4xl text-[#2D2D2D] mb-1">$195 <span class="text-base font-medium text-[#666]">/mo</span></div>
        <p class="text-sm text-[#666] mb-6">Per line</p>
        <ul class="space-y-3 mb-8 text-sm max-w-sm mx-auto text-left">
          <li class="flex items-center gap-2 text-[#333]"><span class="text-[#E5B73C] font-bold">✓</span> AI-powered phone answering 24/7</li>
          <li class="flex items-center gap-2 text-[#333]"><span class="text-[#E5B73C] font-bold">✓</span> Captures every lead via SMS</li>
          <li class="flex items-center gap-2 text-[#333]"><span class="text-[#E5B73C] font-bold">✓</span> Custom greeting and routing</li>
          <li class="flex items-center gap-2 text-[#333]"><span class="text-[#E5B73C] font-bold">✓</span> Never misses a call</li>
        </ul>
        <a href="/contact" class="inline-block bg-[#E5B73C] text-white px-8 py-4 rounded-md font-['Manrope'] font-bold hover:bg-[#CDA333] transition-colors">
          Add to Your Plan
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#2D2D2D] py-20 text-center">
    <div class="max-w-3xl mx-auto px-6">
      <div class="w-16 h-0.5 bg-[rgba(229,183,60,0.4)] mx-auto mb-10"></div>
      <h2 class="font-['Manrope'] text-3xl font-bold text-white mb-4">
        Not Sure Which Plan? <span class="text-[#E5B73C]">Let's Figure It Out.</span>
      </h2>
      <p class="text-[#999] max-w-lg mx-auto mb-10 leading-relaxed">
        15-minute call. No pitch. We'll tell you what you need and what you don't.
      </p>
      <a href="/contact" class="inline-block bg-[#E5B73C] text-white px-8 py-4 rounded-md font-['Manrope'] font-bold hover:bg-[#CDA333] transition-colors">
        Let's Talk
      </a>
    </div>
  </section>
</Layout>