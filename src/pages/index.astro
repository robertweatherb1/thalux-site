---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Your Shop's Digital Infrastructure">
  <!-- Hero Section -->
  <section class="max-w-6xl mx-auto px-6 pt-20 pb-16">
    <div class="max-w-3xl">
      <h1 class="font-['Manrope'] text-4xl md:text-5xl font-extrabold leading-tight tracking-tight text-[#2D2D2D] mb-4">
        Your Shop's <span class="text-[#E5B73C]">Digital Infrastructure</span>
      </h1>
      <p class="text-[#333] text-lg leading-relaxed max-w-xl mb-8">
        Websites that work. Calls that get answered. Customers that find you. Built, managed, and delivered month-to-month.
      </p>
      <a href="/contact" class="inline-block bg-[#E5B73C] text-white px-8 py-4 rounded-md font-['Manrope'] font-bold text-base hover:bg-[#CDA333] transition-colors">
        15-Minute Call — No Pitch
      </a>
    </div>
  </section>

  <!-- Four Products Grid -->
  <section class="bg-white py-16 border-t border-[#DED8D0]">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="font-['Manrope'] text-2xl font-bold text-[#2D2D2D] mb-8">What We Build</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <!-- Website Management -->
        <div class="p-6 rounded-xl border border-[#DED8D0] bg-white">
          <div class="font-['Manrope'] font-bold text-lg text-[#2D2D2D] mb-1">Website Management</div>
          <p class="text-sm text-[#666] leading-relaxed">A website that actually represents your business.</p>
        </div>
        <!-- GBP Optimization -->
        <div class="p-6 rounded-xl border border-[#DED8D0] bg-white">
          <div class="font-['Manrope'] font-bold text-lg text-[#2D2D2D] mb-1">Google Business Profile</div>
          <p class="text-sm text-[#666] leading-relaxed">Show up when customers search. We claim, optimize, and manage your GBP.</p>
        </div>
        <!-- Facebook Marketing -->
        <div class="p-6 rounded-xl border border-[#DED8D0] bg-white">
          <div class="font-['Manrope'] font-bold text-lg text-[#2D2D2D] mb-1">Facebook Marketing</div>
          <p class="text-sm text-[#666] leading-relaxed">Page setup, content calendar, and local ad management.</p>
        </div>
        <!-- Voice Receptionist -->
        <div class="p-6 rounded-xl border border-[#DED8D0] bg-white">
          <div class="font-['Manrope'] font-bold text-lg text-[#2D2D2D] mb-1">Voice Receptionist</div>
          <p class="text-sm text-[#666] leading-relaxed">AI-powered phone answering. Captures every lead, never misses a call.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-16">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="font-['Manrope'] text-2xl font-bold text-[#2D2D2D] mb-10 text-center">How It Works</h2>
      <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="w-12 h-12 bg-[rgba(229,183,60,0.12)] rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-[#E5B73C] font-['Manrope'] font-extrabold text-lg">01</span>
          </div>
          <h3 class="font-['Manrope'] font-bold text-lg text-[#2D2D2D] mb-2">We Audit Your Setup</h3>
          <p class="text-sm text-[#666] leading-relaxed">15-minute call to understand your business and what's missing.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-[rgba(229,183,60,0.12)] rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-[#E5B73C] font-['Manrope'] font-extrabold text-lg">02</span>
          </div>
          <h3 class="font-['Manrope'] font-bold text-lg text-[#2D2D2D] mb-2">We Build What's Missing</h3>
          <p class="text-sm text-[#666] leading-relaxed">Website, GBP, Facebook, voice — tailored to your shop.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-[rgba(229,183,60,0.12)] rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-[#E5B73C] font-['Manrope'] font-extrabold text-lg">03</span>
          </div>
          <h3 class="font-['Manrope'] font-bold text-lg text-[#2D2D2D] mb-2">We Manage It Monthly</h3>
          <p class="text-sm text-[#666] leading-relaxed">Month-to-month. No long-term contracts. We earn our keep.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#2D2D2D] py-20 text-center">
    <div class="max-w-3xl mx-auto px-6">
      <div class="w-16 h-0.5 bg-[rgba(229,183,60,0.4)] mx-auto mb-10"></div>
      <h2 class="font-['Manrope'] text-3xl font-bold text-white mb-4">
        Ready to <span class="text-[#E5B73C]">Get Found?</span>
      </h2>
      <p class="text-[#999] max-w-lg mx-auto mb-10 leading-relaxed">
        15-minute call. No pressure. If we can't help, we'll tell you straight up.
      </p>
      <a href="/contact" class="inline-block bg-[#E5B73C] text-white px-8 py-4 rounded-md font-['Manrope'] font-bold hover:bg-[#CDA333] transition-colors">
        Let's Talk
      </a>
    </div>
  </section>
</Layout>